#!/bin/sh /etc/rc.common
# OpenWrt procd service. No rc.local or background shell hacks.
USE_PROCD=1
START=99
STOP=15

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/libexec/googlewifi-led/googlewifi-led.sh daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd sends SIGTERM; daemon EXIT trap turns RGB channels off.
    :
}
